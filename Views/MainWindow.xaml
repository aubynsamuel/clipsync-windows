<Window
    x:Class="ClipSyncWindows.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ClipSyncWindows"
    xmlns:services="clr-namespace:ClipSyncWindows.Services"
    xmlns:converters="clr-namespace:ClipSyncWindows.Converters"
    xmlns:views="clr-namespace:ClipSyncWindows.Views"
    xmlns:behaviors="clr-namespace:ClipSyncWindows.Behaviors"
    Title="ClipSync"
    Width="550"
    Icon="..\Assets\app.ico"
    Height="650"
    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=WindowBackground}"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareButtonStyle"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonHoverColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="RefreshButtonStyle"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#4B5563" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3C4450" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="StopButtonStyle"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Theme Toggle Button Style -->
        <Style x:Key="ThemeToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmoothScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0" />

                            <ScrollBar
                                Name="PART_VerticalScrollBar"
                                Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmoothScrollListView" TargetType="ListView">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        </Style>

        <converters:FirstLetterConverter x:Key="FirstLetterConverter" />

        <Storyboard x:Key="OpenSettingsStoryboard">
            <DoubleAnimation Storyboard.TargetName="SettingsSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="300" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsOverlay" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="CloseSettingsStoryboard">
            <DoubleAnimation Storyboard.TargetName="SettingsSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="300" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsOverlay" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Border
        Margin="10"
        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.1"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header with Theme Toggle -->
                <Border
                    Grid.Row="0"
                    Padding="0,0,0,15"
                    Background="Transparent">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="ClipSync"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=TitleGradient}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                Text="Seamless clipboard sharing across devices" />
                        </StackPanel>

                        <!-- Theme Toggle Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button
                                x:Name="ThemeToggleButton"
                                Style="{StaticResource ThemeToggleButton}"
                                ToolTip="Toggle Dark/Light Theme">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16">
                                    <TextBlock.Text>
                                        <Binding Source="{x:Static services:ThemeManager.Instance}"
                                            Path="IsDarkTheme">
                                            <Binding.Converter>
                                                <converters:BoolToThemeIconConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Button>
                            <Button
                                x:Name="SettingsButton"
                                Margin="5,0,0,0"
                                Style="{StaticResource ThemeToggleButton}"
                                ToolTip="Open Settings">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        FontWeight="Medium"
                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                        Text="Select devices to share clipboard with:" />

                    <Border
                        Grid.Row="1"
                        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListBackground}"
                        BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ListView
                            Name="DevicesListView"
                            Grid.Row="1"
                            Margin="5"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionMode="Multiple"
                            behaviors:SmoothScrolling.EnableSmoothScrolling="True"
                            Style="{StaticResource SmoothScrollListView}"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="0,4" />
                                    <Setter Property="Background"
                                        Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemBackground}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"
                                                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBackground}" />
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=(behaviors:SmoothScrolling.IsScrolling)}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background"
                                                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Template>
                                <ControlTemplate TargetType="ListView">
                                    <ScrollViewer
                                        x:Name="PART_ScrollViewer"
                                        Padding="{TemplateBinding Padding}"
                                        Focusable="False"
                                        Style="{StaticResource SmoothScrollViewer}">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=IconBackground}"
                                            CornerRadius="20">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=IconForeground}"
                                                Text="{Binding DeviceName, Converter={StaticResource FirstLetterConverter}}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                                Text="{Binding DeviceName}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="12"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding DeviceAddress}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- Button Controls -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,15,0,20"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="RefreshDevicesButton"
                        Margin="0,0,10,0"
                        Content="Refresh Devices"
                        Style="{StaticResource RefreshButtonStyle}" />

                    <Button
                        x:Name="StartServiceButton"
                        Margin="0,0,10,0"
                        Content="Start Service"
                        Style="{StaticResource ModernButton}" />

                    <Button
                        x:Name="StopServiceButton"
                        Content="Stop Service"
                        Style="{StaticResource StopButtonStyle}" />
                </StackPanel>

                <!-- Status Bar -->
                <Border
                    Grid.Row="3"
                    Padding="15,12"
                    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=StatusBarBackground}"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{Binding Source={x:Static services:ThemeManager.Instance}, Path=StatusBarEllipseColor}" />
                            <TextBlock
                                Name="StatusTextBlock"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=IconForeground}"
                                Text="Ready" />
                        </StackPanel>

                        <Button
                            x:Name="ShareButton"
                            Grid.Column="1"
                            Content="Share Clipboard"
                            IsEnabled="False"
                            Style="{StaticResource ShareButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Settings Overlay -->
            <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
                <Border Background="#80000000" MouseDown="SettingsOverlay_MouseDown"/>
                <views:SettingsView x:Name="SettingsSidebar" 
                                    HorizontalAlignment="Right" 
                                    Width="300" 
                                    RenderTransformOrigin="0.5,0.5">
                    <views:SettingsView.RenderTransform>
                        <TranslateTransform X="300"/>
                    </views:SettingsView.RenderTransform>
                </views:SettingsView>
            </Grid>
        </Grid>
    </Border>
</Window>