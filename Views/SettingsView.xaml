<UserControl x:Class="ClipSyncWindows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClipSyncWindows.Views"
             xmlns:viewModels="clr-namespace:ClipSyncWindows.ViewModels"
             xmlns:models="clr-namespace:ClipSyncWindows.Models"
             xmlns:services="clr-namespace:ClipSyncWindows.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="300">
    
    <UserControl.DataContext>
        <viewModels:SettingsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ObjectDataProvider x:Key="ThemeEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AppTheme"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Border Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}" 
            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1,0,0,0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Settings" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"/>

                <Button Grid.Column="1"
                        Content="✕"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                        Cursor="Hand"
                        ToolTip="Close Settings"
                        Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Theme" 
                           FontWeight="SemiBold" 
                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                           Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource ThemeEnumValues}}" 
                          SelectedItem="{Binding Theme}"
                          Padding="10,8"
                          Margin="0,0,0,20"/>
            </StackPanel>

            <TextBlock Grid.Row="2" 
                       Text="{Binding AppVersion, StringFormat='ClipSync {0}'}" 
                       HorizontalAlignment="Center" 
                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                       Opacity="0.6"/>
        </Grid>
    </Border>
</UserControl>
